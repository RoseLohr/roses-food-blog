# /etc/nginx/sites-available/roses-blog
# Reverse Proxy vor dem Podman-Container (127.0.0.1:3000).
# TLS via certbot: sudo certbot --nginx -d www.example.de -d example.de
# certbot ergänzt die TLS-Direktiven und die Weiterleitung von Port 80 selbst.

server {
    listen 80;
    listen [::]:80;
    server_name www.example.de example.de;

    # Uploads (Medienbibliothek) bis 20 MB zulassen
    client_max_body_size 20m;

    # Security-Header (App setzt zusätzlich CSP etc.; HSTS gehört auf den Host)
    # Nach TLS-Einrichtung aktivieren:
    # add_header Strict-Transport-Security "max-age=63072000; includeSubDomains" always;

    # KOMPRIMIERUNG LIEGT HIER, NICHT IN DER APP.
    # next.config.ts setzt `compress: false` — sonst käme jede Antwort schon
    # als gzip an und nginx reichte sie unverändert durch; brotli wäre dann
    # wirkungslos. Beides ist konfiguriert: Browser mit brotli bekommen brotli,
    # alle anderen gzip.
    #
    # brotli braucht das Paket libnginx-mod-http-brotli-filter (Debian/Ubuntu;
    # das Schwesterpaket …-static liefert nur vorkomprimierte .br-Dateien aus
    # und reicht hier NICHT). Es lädt sich über /etc/nginx/modules-enabled/
    # selbst; ein `load_module` gehört NICHT hierher, sondern auf die oberste
    # Ebene der nginx.conf. Fehlt das Modul, kennt nginx die brotli-Direktiven
    # nicht und `nginx -t` schlägt fehl — bootstrap.sh entfernt den Block
    # deshalb, wenn das Modul nicht geladen ist (siehe dort). Wer von Hand
    # einrichtet:
    #   sudo apt install libnginx-mod-http-brotli-filter
    # und bei Fehlanzeige die brotli-Zeilen aus dieser Datei streichen.
    # `text/html` steht in KEINER der beiden Listen und muss das auch nicht:
    # gzip wie brotli binden nginx' Vorgabetabelle ein (ngx_http_types_slot /
    # ngx_http_html_default_types — beim brotli-Modul nachgeprüft), und die
    # enthält text/html unabtrennbar. Eine ausdrückliche Nennung quittiert
    # nginx mit „duplicate MIME type".
    #
    # `text/x-component` dagegen MUSS hier stehen: Damit antwortet der App
    # Router auf jede Client-Navigation (RSC-/Flight-Nutzlast, am gebauten
    # Server nachgemessen). Ohne den Eintrag ginge genau der Verkehr
    # unkomprimiert raus, der beim Klicken durch die Seite entsteht — der Teil,
    # den `compress: false` in next.config.ts vorher abgedeckt hat.
    # Vary MUSS gesetzt sein, sobald die Antwort vom Accept-Encoding des
    # Clients abhängt: Ein geteilter Cache (CDN, Firmenproxy) darf sonst eine
    # brotli-Antwort an einen Client ausliefern, der nur gzip versteht.
    #
    # Bewusst `add_header` statt `gzip_vary on;`: gzip_vary setzt den Header NUR
    # bei Antworten, die der gzip-Filter komprimiert hat. Für brotli-Antworten
    # gäbe es kein Gegenstück — das Modul kennt die Direktive nicht. Nachgesehen
    # in ngx_http_brotli_filter_module.so; es bringt genau mit: brotli,
    # brotli_buffers, brotli_comp_level, brotli_min_length, brotli_ratio,
    # brotli_types, brotli_window. Kein brotli_vary.
    #
    # Der Preis: Auch nie komprimierte Antworten (Bilder, Schriften) tragen den
    # Header und werden im Cache je Accept-Encoding getrennt abgelegt. Das ist
    # der kleinere Schaden gegenüber einer falsch ausgelieferten Kodierung —
    # und die Alternative wären zwei Header an gzip-Antworten.
    add_header Vary Accept-Encoding always;
    gzip on;
    # Ohne das komprimiert gzip NICHT, sobald die Anfrage einen Via-Header
    # trägt — also hinter jedem vorgeschalteten Proxy oder CDN. Die Vorgabe ist
    # `off`, und das wäre hier eine Verschlechterung gegenüber vorher: Next hat
    # bis zu `compress: false` unabhängig davon komprimiert. Betroffen wären
    # ausgerechnet die Clients OHNE brotli — das brotli-Modul kennt keine solche
    # Bedingung und komprimiert ohnehin. (Panel-Befund gpt-5.6-sol.)
    gzip_proxied any;
    gzip_types text/css application/javascript application/json text/x-component image/svg+xml text/xml application/xml;
    # BROTLI-ANFANG (bootstrap.sh entfernt diesen Block ohne Modul)
    brotli on;
    # Stufe 5, gemessen an diesem Bundle (39 JS-Chunks, 1.657 KiB roh; CSS
    # 156 KiB roh) gegen das, was Next heute liefert (gzip Stufe 6):
    #
    #   brotli  5   JS -3,9 %   CSS -6,9 %      50 ms für 1.657 KiB
    #   brotli  6   JS -4,4 %   CSS -7,9 %      57 ms
    #   brotli 11   JS -11,5 %  CSS -16,3 %   2.559 ms  (~1,6 ms je KiB)
    #
    # Stufe 11 wäre deutlich kleiner, kostet aber das Fünfzigfache an Rechenzeit
    # und läuft hier bei JEDER Anfrage neu (nginx komprimiert im Durchreichen,
    # es gibt keinen Vorrat vorkomprimierter Dateien). Für eine 100-KiB-Antwort
    # wären das ~160 ms CPU — das zahlt der nächste Besucher. Stufe 5 kostet
    # dafür ~3 ms. Der Sprung von 5 auf 6 bringt 0,5 Prozentpunkte für 14 %
    # mehr Rechenzeit und lohnt nicht.
    brotli_comp_level 5;
    brotli_types text/css application/javascript application/json text/x-component image/svg+xml text/xml application/xml;
    # BROTLI-ENDE

    location / {
        proxy_pass http://127.0.0.1:3000;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 60s;
    }

    # Daten-Import (Bereich „Daten“ im Admin): ganze Blog-Sicherungen inkl. Fotos
    # können deutlich größer als ein einzelner Medien-Upload sein. Größere Bodys
    # und mehr Zeit für das Verarbeiten zulassen. Wert bei Bedarf erhöhen.
    location = /api/admin/daten/import {
        client_max_body_size 200m;
        proxy_pass http://127.0.0.1:3000;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 600s;
    }

    # Statische Next-Assets aggressiv cachen lassen (Cache-Header setzt die App;
    # hier nur Weiterleitung — kein eigenes Caching nötig bei dieser Größe).
}
